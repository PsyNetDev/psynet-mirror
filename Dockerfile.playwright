# Extends the main PsyNet build image with pre-installed Playwright browsers.
# cdn.playwright.dev is unreachable from CI runners, so we copy the browser
# cache from the official Playwright Docker image instead of running
# `npx playwright install` at test time.
#
# The Playwright image tag must match @playwright/test in package.json. The
# noble variant's browsers run on Debian 13 because noble's glibc (2.39) is
# older than Debian 13's (2.41).
ARG DOCKER_PLATFORM=linux/amd64
ARG BASE_IMAGE=psynet-build

FROM --platform=${DOCKER_PLATFORM} mcr.microsoft.com/playwright:v1.64.1-noble AS playwright-browsers

FROM ${BASE_IMAGE}
# The participant recording helper (record-participant-video skill) muxes
# audio and video with the system ffmpeg and ffprobe.
RUN apt-get-update && timeout --kill-after=10 900 apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY --from=playwright-browsers /ms-playwright /ms-playwright
