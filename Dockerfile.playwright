# Image for the Playwright e2e jobs, built on the official Playwright image.
# Its Chromium, Firefox and WebKit builds and their system libraries are
# Ubuntu builds: WebKit does not start on the Debian base of the main
# Dockerfile, and cdn.playwright.dev, where `npx playwright install` would
# fetch a Debian build, is unreachable from CI runners. The image also
# provides xvfb-run, which Firefox needs for screen capture.
#
# The Playwright image tag must match @playwright/test in package.json.
# PsyNet itself is installed as in the main Dockerfile; keep the two in sync.
ARG DOCKER_PLATFORM=linux/amd64
FROM --platform=${DOCKER_PLATFORM} mcr.microsoft.com/playwright:v1.63.0-noble
ARG PYTHON_VERSION=3.14

ENV UV_HTTP_RETRIES=8
ENV HEADLESS=TRUE

COPY ci/apt-get-update.sh /usr/local/bin/apt-get-update
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\n' > /etc/apt/apt.conf.d/80-ci-network
# The Playwright image fetches Ubuntu packages from Azure's mirror, which CI
# runners cannot reach; use Ubuntu's own archive instead.
RUN sed -i 's|http://azure.archive.ubuntu.com/ubuntu/|http://archive.ubuntu.com/ubuntu/|' /etc/apt/sources.list.d/ubuntu.sources
# fonts-liberation gives browser tests an Arial-metric font, which is what the
# participant theme's fallback face is measured against. The participant
# recording helper (record-participant-video skill) muxes audio and video
# with ffmpeg and ffprobe. PulseAudio gives the browsers an audio output (see
# ci/start-pulseaudio.sh).
RUN apt-get-update && timeout --kill-after=10 900 apt-get install -y --no-install-recommends \
        build-essential curl ffmpeg fonts-liberation gettext git jq libpq-dev pulseaudio redis-server rsync unzip wget && \
    rm -rf /var/lib/apt/lists/*
COPY ci/start-pulseaudio.sh /usr/local/bin/start-pulseaudio
ENTRYPOINT ["/usr/local/bin/start-pulseaudio"]

# Heroku CLI runs the legacy `psynet debug local` that playwright_e2e_legacy uses.
RUN curl --fail --location --show-error --retry 5 --retry-connrefused --retry-delay 2 \
        --output /tmp/heroku-install.sh https://cli-assets.heroku.com/install.sh && \
    sh /tmp/heroku-install.sh && \
    rm /tmp/heroku-install.sh && \
    heroku --version

# Ubuntu's Python is older than PsyNet's default, so uv installs that into a
# virtual environment that comes first on PATH. UV_PYTHON makes
# `uv pip install --system` install into it, as into the main image's Python.
RUN curl --fail --location --show-error --retry 5 --retry-connrefused --retry-delay 2 \
        https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv venv --python ${PYTHON_VERSION} --seed /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV UV_PYTHON=/opt/venv/bin/python
ENV PATH=/opt/venv/bin:$PATH

COPY pyproject.toml pyproject.toml
COPY ci/dallinger-dev-requirements.txt dallinger-dev-requirements.txt
RUN uv pip compile --python-version ${PYTHON_VERSION} pyproject.toml \
        --extra experiment --extra demos \
        --constraint dallinger-dev-requirements.txt \
        --output-file constraints.txt
RUN uv pip install --no-cache --system -r constraints.txt
