// .vscode/settings.json stores the user's VSCode settings.
// This file provides an example configuration for PsyNet users.
// To use it yourself, rename the file to settings.json.
//
// See also the PsyNet repository's .vscode/settings.json.example file
// (consider propagating any changes there)
{
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    "sqltools.connections": [
        {
            "ssh": "Disabled",
            "previewLimit": 50,
            "server": "localhost",
            "port": 5432,
            "driver": "PostgreSQL",
            "name": "dallinger",
            "database": "dallinger",
            "username": "dallinger",
            "password": "dallinger"
        }
    ]
}
