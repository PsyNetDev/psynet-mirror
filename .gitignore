# Files that should be ignored within experiment directories,
# but might become visible when switching branches.
source_code.zip
.deploy
**/static/assets
**/deploy_logs/
dump.rdb

# Scaffold and dependency files generated inside bundled demos.
# Patterns use ``/**/`` so nested experiment roots (e.g. create_and_rate/basic)
# are covered.
/demos/**/.dockerignore
/demos/**/.gitignore
/demos/**/.python-version
/demos/**/.github/workflows/test.yml
/demos/**/.vscode/launch.json
/demos/**/AGENTS.md
/demos/**/Dockerfile
/demos/**/Dockertag
/demos/**/__init__.py
/demos/**/config.txt
# Generated by `uv run` when helper scripts execute from the repo root.
/uv.lock

/demos/**/constraints.txt
/demos/**/deploy.toml
/demos/**/docker/
/demos/**/pytest.ini
/demos/**/test.py

# Scaffold and dependency files generated inside test experiments.
# Stock config.txt is ignored like demos; already-tracked custom configs stay
# tracked. Use ``git add -f path/to/config.txt`` when first adding a new custom
# config under these trees.
/tests/experiments/**/.dockerignore
/tests/experiments/**/.gitignore
/tests/experiments/**/.python-version
/tests/experiments/**/.github/workflows/test.yml
/tests/experiments/**/.vscode/launch.json
/tests/experiments/**/AGENTS.md
/tests/experiments/**/README.md
/tests/experiments/**/Dockerfile
/tests/experiments/**/Dockertag
/tests/experiments/**/__init__.py
/tests/experiments/**/config.txt
/tests/experiments/**/constraints.txt
/tests/experiments/**/deploy.toml
/tests/experiments/**/docker/
/tests/experiments/**/pytest.ini
/tests/experiments/**/test.py
/tests/playwright/experiments/**/.dockerignore
/tests/playwright/experiments/**/.gitignore
/tests/playwright/experiments/**/.python-version
/tests/playwright/experiments/**/.github/workflows/test.yml
/tests/playwright/experiments/**/.vscode/launch.json
/tests/playwright/experiments/**/AGENTS.md
/tests/playwright/experiments/**/README.md
/tests/playwright/experiments/**/Dockerfile
/tests/playwright/experiments/**/Dockertag
/tests/playwright/experiments/**/__init__.py
/tests/playwright/experiments/**/config.txt
/tests/playwright/experiments/**/constraints.txt
/tests/playwright/experiments/**/deploy.toml
/tests/playwright/experiments/**/docker/
/tests/playwright/experiments/**/pytest.ini
/tests/playwright/experiments/**/test.py
# Authored-only in master; deployment-test branches force-add these with
# ``git add -f`` when materializing a deployable tree (see deployment-test skill).
/tests/deployment/**/.dockerignore
/tests/deployment/**/.gitignore
/tests/deployment/**/.python-version
/tests/deployment/**/.github/workflows/test.yml
/tests/deployment/**/.vscode/launch.json
/tests/deployment/**/AGENTS.md
/tests/deployment/**/README.md
# Vendored consent packages ship their own authored README.
!/tests/deployment/**/consents_cococo/README.md
/tests/deployment/**/Dockerfile
/tests/deployment/**/Dockertag
/tests/deployment/**/__init__.py
/tests/deployment/**/config.txt
/tests/deployment/**/constraints.txt
/tests/deployment/**/deploy.toml
/tests/deployment/**/docker/
/tests/deployment/**/pytest.ini
/tests/deployment/**/test.py
# Vendored consent packages under deployment tests are real Python packages.
!/tests/deployment/**/consents_cococo/__init__.py

# ASV benchmark artifacts
.asv/
.asv-sync.conf.json
.asv-local.conf.json

# Deployment-test audit trail: local-only analyses and raw artifacts
# (logs, exports, recruiter JSON). Do not commit this tree.
deployment-tests/
